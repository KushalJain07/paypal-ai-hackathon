# Copy to .env and fill with credentials from your PayPal Sandbox app.
# Never commit .env or place these values in client-side code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_AUTOMATION_ENABLED=false
PAYPAL_SMOKE_PAYEE_EMAIL=

# REWIND approval provider. Manual is the safe default; Kernel uses a persistent
# Sandbox-buyer browser profile and must never be pointed at live PayPal.
APPROVAL_PROVIDER=kernel
APPROVAL_FALLBACK_MANUAL=true
KERNEL_API_KEY=
KERNEL_PROFILE_NAME=
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Server-only HMAC key for signing REWIND mandates (use a random value of 32+ chars).
MANDATE_SIGNING_SECRET=

# Server-only Supabase credentials for the REWIND Orders persistence layer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Agent runtime settings. The agent calls the REWIND HTTP API; it has no PayPal adapter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
REWIND_API_BASE_URL=http://localhost:3000

# Background REWIND release worker and optional event webhook.
WORKER_INTERVAL_MS=3000
STALE_CLAIM_SECONDS=120
ZAPIER_WEBHOOK_URL=
