# Copy to .env.local and fill with credentials from your PayPal Sandbox app.
# Never commit .env.local or place these values in client-side code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_AUTOMATION_ENABLED=false
PAYPAL_SMOKE_PAYEE_EMAIL=

# Server-only Supabase credentials for the REWIND Orders persistence layer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
